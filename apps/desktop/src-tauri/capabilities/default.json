{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal main-window capability for Runtime progress events and the signed Desktop App updater.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "updater:default",
    "process:allow-restart"
  ]
}
