{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tfcup/deepseek-harness-desktop/updater/schema/runtime-manifest.schema.json",
  "title": "RuntimeManifest",
  "description": "DeepSeek Harness Desktop 内置 Runtime Manifest",
  "type": "object",
  "required": [
    "schemaVersion", "runtimeVersion", "harnessVersion",
    "extensionVersion", "nodeVersion", "platform", "arch", "sha256", "publishedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "runtimeVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "harnessVersion": { "type": "string" },
    "extensionVersion": { "type": "string" },
    "nodeVersion": { "type": "string" },
    "platform": { "type": "string", "const": "darwin" },
    "arch": { "type": "string", "const": "arm64" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
