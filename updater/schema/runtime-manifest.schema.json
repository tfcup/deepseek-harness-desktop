{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tfcup/deepseek-harness-desktop/updater/schema/runtime-manifest.schema.json",
  "title": "RuntimeManifest",
  "description": "DeepSeek Harness Desktop Runtime Manifest（设计文档 §7 / §26）—— 一次 Runtime 发布是完整发行单元：Harness + Extension Pack + Node + Compatibility Fix",
  "type": "object",
  "required": [
    "schemaVersion", "channel", "runtimeVersion", "harnessVersion",
    "extensionVersion", "nodeVersion", "platform", "arch", "url", "sha256",
    "minimumDesktopVersion", "publishedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "channel": { "type": "string", "enum": ["dev", "beta", "stable"] },
    "runtimeVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "harnessVersion": { "type": "string" },
    "extensionVersion": { "type": "string" },
    "nodeVersion": { "type": "string" },
    "platform": { "type": "string", "const": "darwin" },
    "arch": { "type": "string", "const": "arm64" },
    "url": { "type": "string", "format": "uri" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "minimumDesktopVersion": { "type": "string" },
    "publishedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
